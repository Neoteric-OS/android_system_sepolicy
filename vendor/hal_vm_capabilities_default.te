type hal_vm_capabilities_default, domain;

hal_server_domain(hal_vm_capabilities_default, hal_vm_capabilities);

type hal_vm_capabilities_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_vm_capabilities_default);

# virtmanager passes the vm_fd to the HAL to enable custom vendor specific SMCs for this VM.
until_board_api(202604, `
allow hal_vm_capabilities_default crosvm:fd use;
neverallow hal_vm_capabilities_default crosvm:fd ~use;
')

starting_at_board_api(202604, `
allow hal_vm_capabilities_default crosvm_vendor:fd use;
neverallow hal_vm_capabilities_default crosvm_vendor:fd ~use;
')

