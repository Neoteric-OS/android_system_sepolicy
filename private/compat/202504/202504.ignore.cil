;; new_objects - a collection of types that have been introduced with ToT policy
;;   that have no analogue in 202504 policy.  Thus, we do not need to map these types to
;;   previous ones.  Add here to pass checkapi tests.
(type new_objects)
(typeattribute new_objects)
(typeattributeset new_objects
  ( new_objects
    hal_bluetooth_lpp_service
    hal_frp_service
    init_dev_config
    init_dev_config_exec
    native_binder_stats_prop
    native_serial_service
    pbtombstone_exec
    prefetch
    task_continuity_service
    trusty_coverage_prop
    omapi
    omapi_exec
    omapi_service
    serialservice
    serialservice_exec
    usb_disable_when_locked_prop
    usb_userspace_aoa_enabled_prop
    virtualizationservice_data_file
    wallet_prop
    anomaly_detector_service
    uprobestats_service
    remote_prov_prop
  ))
