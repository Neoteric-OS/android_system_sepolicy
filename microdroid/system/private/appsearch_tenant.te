# appsearch_tenant is a specialized domain for running appsearch in Microdroid

type appsearch_tenant, domain, coredomain, microdroid_payload;
type appsearch_tenant_exec, exec_type, file_type, system_file_type;

# Allow appsearch_tenant to write to the kernel log
allow appsearch_tenant kmsg_device:chr_file w_file_perms;
allow appsearch_tenant kmsg_debug_device:chr_file w_file_perms;

# Allow appsearch_tenant to read /apex directory to learn about activated
# APEXes. It uses this to create linker namespace links to those APEXes.
allow appsearch_tenant apex_mnt_dir:dir r_dir_perms;

# TODO(b/470085390): Remove when `appsearch_tenant` is no longer used by the
# test APK.
# Allow the Microdroid launcher (running in `appsearch_tenant`) to execute
# shared libraries (.so files) located within the test APK.
allow appsearch_tenant tenant_apk_file:file x_file_perms;
